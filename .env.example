# Local / Railway (never commit real secrets)
PORT=5000
NODE_ENV=production
# Railway volume: mount /data → set DATABASE_PATH=/data/data.db
DATABASE_PATH=/data/data.db
# Editor gate (required for write APIs)
EED_EDIT_SECRET=
# If Railway truncates long secrets, split across P0..P3 (all required):
# EED_EDIT_SECRET_P0=
# EED_EDIT_SECRET_P1=
# EED_EDIT_SECRET_P2=
# EED_EDIT_SECRET_P3=
